+#include <cstdlib>
 #include <algorithm>
 #include <array>
 #include <cstddef>
@@ -755,6 +756,26 @@ VulkanTextureCache::SamplerParameters VulkanTextureCache::GetSamplerParameters(
   }
   parameters.aniso_filter = aniso_filter;
 
+  // Debug override (env CATH_SAMPLER_DBG): 1 = force clamp-to-edge, 2 = force point filtering,
+  // 4 = force clamp-to-edge only where the game asked for a border.
+  static const int cath_dbg = std::getenv("CATH_SAMPLER_DBG") ? std::atoi(std::getenv("CATH_SAMPLER_DBG")) : 0;
+  if (cath_dbg & 1) {
+    parameters.clamp_x = parameters.clamp_y = parameters.clamp_z = xenos::ClampMode::kClampToEdge;
+  }
+  if (cath_dbg & 4) {
+    if (xenos::ClampModeUsesBorder(parameters.clamp_x)) parameters.clamp_x = xenos::ClampMode::kClampToEdge;
+    if (xenos::ClampModeUsesBorder(parameters.clamp_y)) parameters.clamp_y = xenos::ClampMode::kClampToEdge;
+    if (xenos::ClampModeUsesBorder(parameters.clamp_z)) parameters.clamp_z = xenos::ClampMode::kClampToEdge;
+  }
+  if (cath_dbg & 2) {
+    parameters.mag_linear = false;
+    parameters.min_linear = false;
+  }
+  if (cath_dbg & 8) {
+    // Sample only the top (full-size) mip level.
+    parameters.mip_linear = false;
+    parameters.mip_base_map = true;
+  }
   return parameters;
