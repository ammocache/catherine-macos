   rex::perf::Profiler::Flip();
 
+  // Catherine: optional guest FPS logging (set env CATH_FPS_LOG=1).
+  {
+    static const bool fps_log = std::getenv("CATH_FPS_LOG") != nullptr;
+    if (fps_log) {
+      static uint64_t window_start = 0;
+      static uint32_t window_frames = 0;
+      uint64_t now = rex::chrono::Clock::QueryHostTickCount();
+      uint64_t freq = rex::chrono::Clock::QueryHostTickFrequency();
+      if (!window_start) window_start = now;
+      ++window_frames;
+      if (now - window_start >= freq * 2) {
+        double secs = double(now - window_start) / double(freq);
+        REXLOG_ERROR("GUEST_FPS {:.1f}", window_frames / secs);
+        window_start = now;
+        window_frames = 0;
+      }
+    }
+  }
