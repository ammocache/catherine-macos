+bool AutomationIgnoresFocus() {
+  static const bool v = std::getenv("CATH_AUTOMATION") != nullptr;
+  return v;
+}
+// Automated key presses arrive faster than the game polls input, so in automation
+// mode every key is held for at least kAutoMinHold.
+constexpr auto kAutoMinHold = std::chrono::milliseconds(150);
+std::chrono::steady_clock::time_point g_auto_press_time[256];
+bool g_auto_release_pending[256] = {};
+
+// ---- Catherine test automation: scripted controller input from a text file ----
+// With CATH_AUTOMATION=1, lines appended to $CATH_AUTOMATION_INPUT (default
+// ~/catherine-project/runner/input.txt) are played back as button presses.
+// Line format: "<BUTTON> [hold_ms]" or "WAIT <ms>". Buttons: A B X Y START BACK
+// UP DOWN LEFT RIGHT (d-pad) LB RB LT RT LS_UP LS_DOWN LS_LEFT LS_RIGHT
+// RS_UP RS_DOWN RS_LEFT RS_RIGHT.
+using namespace rex::input;
+struct AutoStep {
+  uint16_t buttons = 0;
+  uint8_t lt = 0, rt = 0;
+  int32_t lx = 0, ly = 0, rx = 0, ry = 0;
+  int hold_ms = 0;
+};
+struct AutoInputState {
+  std::deque<AutoStep> queue;
+  size_t lines_done = 0;
+  std::chrono::steady_clock::time_point next_poll{};
+  std::chrono::steady_clock::time_point step_end{};
+  bool step_active = false;
+  AutoStep current;
+};
+AutoInputState g_auto;
+
+std::string AutoInputPath() {
+  if (const char* p = std::getenv("CATH_AUTOMATION_INPUT")) return p;
+  const char* home = std::getenv("HOME");
+  return std::string(home ? home : ".") + "/catherine-project/runner/input.txt";
+}
+
+bool ParseAutoLine(const std::string& raw, std::vector<AutoStep>& out) {
+  std::istringstream in(raw);
+  std::string tok;
+  if (!(in >> tok)) return false;
+  for (auto& c : tok) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+  int ms = 0;
+  in >> ms;
+  AutoStep st;
+  constexpr int32_t M = INT16_MAX;
+  if (tok == "WAIT") { st.hold_ms = ms > 0 ? ms : 500; out.push_back(st); return true; }
+  if (tok == "A") st.buttons = X_INPUT_GAMEPAD_A;
+  else if (tok == "B") st.buttons = X_INPUT_GAMEPAD_B;
+  else if (tok == "X") st.buttons = X_INPUT_GAMEPAD_X;
+  else if (tok == "Y") st.buttons = X_INPUT_GAMEPAD_Y;
+  else if (tok == "START") st.buttons = X_INPUT_GAMEPAD_START;
+  else if (tok == "BACK") st.buttons = X_INPUT_GAMEPAD_BACK;
+  else if (tok == "UP") st.buttons = X_INPUT_GAMEPAD_DPAD_UP;
+  else if (tok == "DOWN") st.buttons = X_INPUT_GAMEPAD_DPAD_DOWN;
+  else if (tok == "LEFT") st.buttons = X_INPUT_GAMEPAD_DPAD_LEFT;
+  else if (tok == "RIGHT") st.buttons = X_INPUT_GAMEPAD_DPAD_RIGHT;
+  else if (tok == "LB") st.buttons = X_INPUT_GAMEPAD_LEFT_SHOULDER;
+  else if (tok == "RB") st.buttons = X_INPUT_GAMEPAD_RIGHT_SHOULDER;
+  else if (tok == "LT") st.lt = 0xFF;
+  else if (tok == "RT") st.rt = 0xFF;
+  else if (tok == "LS_UP") st.ly = M;
+  else if (tok == "LS_DOWN") st.ly = -M;
+  else if (tok == "LS_LEFT") st.lx = -M;
+  else if (tok == "LS_RIGHT") st.lx = M;
+  else if (tok == "RS_UP") st.ry = M;
+  else if (tok == "RS_DOWN") st.ry = -M;
+  else if (tok == "RS_LEFT") st.rx = -M;
+  else if (tok == "RS_RIGHT") st.rx = M;
+  else return false;
+  st.hold_ms = ms > 0 ? ms : 150;
+  out.push_back(st);
+  AutoStep gap;  // release before the next press
+  gap.hold_ms = 150;
+  out.push_back(gap);
+  return true;
+}
+
+// Returns the scripted input for this poll (all zero when idle).
+AutoStep PollAutoInput() {
+  auto now = std::chrono::steady_clock::now();
+  if (now >= g_auto.next_poll) {
+    g_auto.next_poll = now + std::chrono::milliseconds(100);
+    std::ifstream f(AutoInputPath());
+    if (f) {
+      std::vector<std::string> lines;
+      std::string line;
+      while (std::getline(f, line)) lines.push_back(line);
+      if (lines.size() < g_auto.lines_done) g_auto.lines_done = 0;  // file was reset
+      for (size_t i = g_auto.lines_done; i < lines.size(); ++i) {
+        std::vector<AutoStep> steps;
+        if (ParseAutoLine(lines[i], steps)) {
+          REXLOG_ERROR("AUTO_INPUT {}", lines[i]);
+          for (auto& st : steps) g_auto.queue.push_back(st);
+        }
+      }
+      g_auto.lines_done = lines.size();
+    }
+  }
+  if (g_auto.step_active && now >= g_auto.step_end) g_auto.step_active = false;
+  if (!g_auto.step_active && !g_auto.queue.empty()) {
+    g_auto.current = g_auto.queue.front();
+    g_auto.queue.pop_front();
+    g_auto.step_end = now + std::chrono::milliseconds(g_auto.current.hold_ms);
+    g_auto.step_active = true;
+  }
+  return g_auto.step_active ? g_auto.current : AutoStep{};
+}
+}  // namespace
