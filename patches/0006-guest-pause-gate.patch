diff --git a/include/rex/system/guest_pause.h b/include/rex/system/guest_pause.h
new file mode 100644
index 0000000..eb26afc
--- /dev/null
+++ b/include/rex/system/guest_pause.h
@@ -0,0 +1,13 @@
+// Catherine addition: cooperative "pause the game" gate.
+// While paused, the guest blocks at its next VdSwap (once per frame), which
+// stops the game loop without freezing host threads mid-work.
+#pragma once
+
+namespace rex::system {
+
+void SetGuestPaused(bool paused);
+bool IsGuestPaused();
+// Called by the guest's per-frame path; blocks while paused.
+void WaitWhileGuestPaused();
+
+}  // namespace rex::system
