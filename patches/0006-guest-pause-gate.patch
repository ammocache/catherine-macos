 #include <rex/system/kernel_state.h>
 #include <rex/system/xtypes.h>
 #include <rex/ui/flags.h>
 
+namespace rex::system {
+namespace {
+std::mutex g_pause_mutex;
+std::condition_variable g_pause_cv;
+bool g_paused = false;
+}  // namespace
+void SetGuestPaused(bool paused) {
+  {
+    std::lock_guard<std::mutex> lock(g_pause_mutex);
+    g_paused = paused;
+  }
+  g_pause_cv.notify_all();
+}
+bool IsGuestPaused() {
+  std::lock_guard<std::mutex> lock(g_pause_mutex);
+  return g_paused;
+}
+void WaitWhileGuestPaused() {
+  std::unique_lock<std::mutex> lock(g_pause_mutex);
+  g_pause_cv.wait(lock, [] { return !g_paused; });
+}
+}  // namespace rex::system
